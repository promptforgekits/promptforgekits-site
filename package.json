{
  "name": "promptforgekits-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Marketing site for Prompt Forge Kits (promptforgekits.com)",
  "scripts": {
    "build": "node src/build.mjs",
    "dev": "node src/build.mjs && npx --yes serve@14 dist -l 4321",
    "preview": "npx --yes serve@14 dist -l 4321",
    "sync-demos": "bash scripts/sync-demos.sh",
    "test": "node --test test/",
    "pdf": "node src/build.mjs && google-chrome --headless --no-sandbox --no-pdf-header-footer --print-to-pdf=public/downloads/prompt-forge-free-prompt-pack.pdf file://$PWD/scripts/freepack-print.html"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "pdf-lib": "^1.17.1"
  }
}
